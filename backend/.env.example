# Entorno
NODE_ENV=development
PORT=4000

# Base de datos (compose.yaml expone Postgres en 127.0.0.1:5434)
DATABASE_URL=postgresql://scesi:scesi@localhost:5434/scesi_events

# Autenticación (usa valores largos y aleatorios en producción)
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo-y-aleatorio
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS (origen del frontend)
CORS_ORIGIN=http://localhost:3000

# Almacenamiento de archivos: local | cloudinary
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage
# CLOUDINARY_URL=cloudinary://...

# Correo: console | resend | smtp
MAIL_PROVIDER=console
MAIL_FROM=SCESI <no-reply@scesi.org>
# RESEND_API_KEY=...

# URL pública del frontend (enlaces en correos y QR)
APP_PUBLIC_URL=http://localhost:3000
